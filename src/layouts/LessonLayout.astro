---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Footer from '../components/layout/Footer.astro';
import LessonComplete from '../components/progress/LessonComplete';
import type { Lesson } from '../lib/lessons';
import type { LessonNav } from '../lib/navigation';
import { MODULES } from '../lib/curriculum';

interface Props {
  lesson: Lesson;
  allLessons: Lesson[];
  nav: LessonNav;
}

const { lesson, allLessons, nav } = Astro.props;
const { day, title, module: moduleId, phase, dartConcept, csharpConcept, learningObjectives, prerequisites, sources, estimatedMinutes, isProject, projectType } = lesson.data;

const mod = MODULES.find(m => m.id === moduleId)!;
const phaseLabel = phase === 'csharp' ? 'Phase 1: C# Language' : 'Phase 2: .NET & ASP.NET';
const nextUrl = nav.next ? `${import.meta.env.BASE_URL}lessons/day-${String(nav.next.data.day).padStart(3, '0')}` : undefined;
const objectives = learningObjectives ?? [
  `Explain ${csharpConcept} in terms a Dart developer can use.`,
  isProject ? 'Build the project incrementally and verify its observable behavior.' : 'Apply the concept in a small example and verify the result.',
];
const requiredKnowledge = prerequisites ?? [
  day === 1 ? 'Professional Dart or Flutter experience' : `The concepts and exercise from Day ${day - 1}`,
];
---

<BaseLayout title={`Day ${day}: ${title}`} description={`Day ${day} — ${title}. Learn ${csharpConcept} in C# from a Dart developer perspective.`}>
  <Header currentDay={day} />

  <div class="flex">
    <Sidebar lessons={allLessons} currentDay={day} />

    <!-- Main content -->
    <main class="flex-1 lg:ml-72 min-w-0">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-slate-600 mb-6">
          <a href={import.meta.env.BASE_URL} class="hover:text-slate-400 transition-colors">Dashboard</a>
          <span>/</span>
          <a href={`${import.meta.env.BASE_URL}modules/${mod.slug}`} class="hover:text-slate-400 transition-colors">{mod.shortName}</a>
          <span>/</span>
          <span class="text-slate-400">Day {day}</span>
        </nav>

        <!-- Lesson header -->
        <header class="mb-8">
          <!-- Phase + Module badge -->
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-xs px-2.5 py-1 rounded-full font-medium"
              style={`background-color: ${mod.color}22; color: ${mod.color}; border: 1px solid ${mod.color}44`}
            >
              {mod.icon} {mod.shortName}
            </span>
            {isProject && (
              <span class={`text-xs px-2.5 py-1 rounded-full font-medium border ${
                projectType === 'capstone'
                  ? 'bg-amber-950/50 text-amber-300 border-amber-700/50'
                  : 'bg-purple-950/50 text-purple-300 border-purple-700/50'
              }`}>
                {projectType === 'capstone' ? '🏆 Capstone Project' : '🔨 Mini-Project'}
              </span>
            )}
            <span class="text-xs text-slate-600 ml-auto">⏱ {estimatedMinutes} min · Week {Math.ceil(day / 5)}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-bold text-white leading-tight mb-3">
            <span class="text-slate-600 font-normal text-lg">Day {day} — </span>
            {title}
          </h1>

          {dartConcept && (
            <p class="text-sm text-slate-500">
              <span class="text-teal-500">Dart:</span> {dartConcept}
              <span class="text-slate-700 mx-2">→</span>
              <span class="text-indigo-400">C#:</span> {csharpConcept}
            </p>
          )}
        </header>

        <!-- Lesson content -->
        <article class="prose prose-invert prose-slate max-w-none prose-headings:scroll-mt-20 prose-h1:text-2xl prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3 prose-p:leading-relaxed prose-p:text-slate-300 prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline prose-code:text-teal-300 prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-700 prose-hr:border-slate-700 prose-strong:text-white prose-li:text-slate-300 prose-li:leading-relaxed">
          <section class="not-prose grid sm:grid-cols-2 gap-3 mb-8" aria-label="Lesson guide">
            <div class="rounded-xl border border-indigo-900/60 bg-indigo-950/20 p-4">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-indigo-400 mb-2">Learning objectives</h2>
              <ul class="space-y-1.5 text-sm text-slate-300 list-disc pl-4">
                {objectives.map(objective => <li>{objective}</li>)}
              </ul>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Before you begin</h2>
              <ul class="space-y-1.5 text-sm text-slate-400 list-disc pl-4">
                {requiredKnowledge.map(prerequisite => <li>{prerequisite}</li>)}
              </ul>
              <p class="text-xs text-slate-500 mt-3">Baseline: .NET 10 LTS and C# 14. Run examples unless they are labeled as excerpts or expected errors.</p>
            </div>
          </section>
          <slot />
          {sources && sources.length > 0 && (
            <section>
              <h2>Primary documentation</h2>
              <ul>
                {sources.map(source => <li><a href={source}>{source}</a></li>)}
              </ul>
            </section>
          )}
        </article>

        <!-- Complete button -->
        <LessonComplete day={day} nextUrl={nextUrl} client:load />

        <!-- Prev/Next footer -->
        <Footer prev={nav.prev} next={nav.next} />
      </div>
    </main>
  </div>

  <!-- Mobile sidebar toggle -->
  <button
    id="sidebar-toggle"
    class="fixed bottom-6 right-6 lg:hidden z-50 w-12 h-12 rounded-full bg-indigo-600 text-white shadow-lg flex items-center justify-center text-lg"
    onclick="
      const s = document.getElementById('sidebar');
      const o = document.getElementById('sidebar-overlay');
      s?.classList.toggle('-translate-x-full');
      o?.classList.toggle('hidden');
    "
  >
    ☰
  </button>
</BaseLayout>
