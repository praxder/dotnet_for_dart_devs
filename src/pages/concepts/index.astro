---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import { getConceptSlug } from '../../lib/concepts.mjs';

const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="C# and .NET Application Concepts" description="The high-level runtime and application concepts that make .NET different from Flutter and Dart.">
  <Header />
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <a href={import.meta.env.BASE_URL} class="text-xs text-slate-500 hover:text-slate-300">← Dashboard</a>
    <header class="mt-8 mb-10">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-400 mb-3">Architecture guide</p>
      <h1 class="text-3xl font-bold text-white mb-3">C# and .NET application concepts</h1>
      <p class="max-w-2xl text-slate-400 leading-relaxed">
        Syntax gets code compiling. These concepts explain how production .NET applications execute, share resources, handle concurrency, and fail safely. They are supplemental and do not change your 130-lesson progress.
      </p>
    </header>
    <ol class="grid md:grid-cols-2 gap-4">
      {concepts.map(concept => (
        <li>
          <a href={`${import.meta.env.BASE_URL}concepts/${getConceptSlug(concept.id)}`} class="block h-full rounded-xl border border-slate-800 p-5 hover:border-indigo-700 hover:bg-slate-900/60 transition-colors">
            <div class="text-xs text-slate-600 mb-2">Concept {concept.data.order}</div>
            <h2 class="font-semibold text-white mb-2">{concept.data.title}</h2>
            <p class="text-sm text-slate-400 leading-relaxed">{concept.data.summary}</p>
            <p class="text-xs text-teal-400 mt-4">Flutter bridge: {concept.data.flutterAnalogy}</p>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
